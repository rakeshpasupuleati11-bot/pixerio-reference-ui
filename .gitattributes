# Normalise text files to LF so diffs show real changes, not line-ending churn
* text=auto eol=lf

# Windows launchers must keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.mp4 binary
*.zip binary
*.pdf binary
